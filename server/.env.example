# Fixer API — environment template (Phase 14)
# Copy to .env and fill values. Never commit real secrets.

NODE_ENV=production
PORT=5000

# MongoDB Atlas connection string (include authSource / retryWrites)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/fixer?retryWrites=true&w=majority

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_AT_LEAST_48_CHARS_LONG_RANDOM
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_AT_LEAST_48_CHARS_LONG_RANDOM
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Public SPA origin (no trailing slash). Comma-separate extras in ALLOWED_ORIGINS.
CLIENT_ORIGIN=https://fixer.example.com
ALLOWED_ORIGINS=https://www.fixer.example.com

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
PUBLIC_RATE_LIMIT_MAX=30

# Behind Vercel / reverse proxy
TRUST_PROXY=true

# Logging
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
HEALTH_DEEP_CHECK=true

# Optional — Cloudinary media
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
