# ==========================================================
# REPAIRFLOW — Server Environment
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ==========================================================

# Runtime
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# MongoDB — local development
MONGODB_URI=mongodb://localhost:27017/repairflow

# MongoDB Atlas (production) — uncomment and use instead:
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/repairflow?retryWrites=true&w=majority

# JWT — REQUIRED in production, minimum 32 characters each.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev_access_secret_change_me_min_32_chars_flow
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_min_32_chars_flow
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary — required for uploads (device photos, avatars, repair documentation)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=repairflow

# Optional
API_VERSION=0.1.0
