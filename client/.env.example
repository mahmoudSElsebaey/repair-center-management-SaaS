# ==========================================================
# FIXER — Client Environment
# Copy this file to `.env` (or `.env.local`) and adjust.
# Only `VITE_*` variables are exposed to the browser.
# NEVER put a secret, API key or database URL in this file.
# ==========================================================

# Base URL of the Fixer API, including the version segment.
# Leave empty in development so requests go to `/api/v1` and the Vite dev
# server proxies them to http://localhost:5000 (no CORS, no extra config).
#
# Production example:
# VITE_API_URL=https://repairflow-api.vercel.app/api/v1
VITE_API_URL=

# Product name shown in the document title and shell.
VITE_APP_NAME=Fixer

# Locale and theme applied on a first visit. A stored preference always wins.
VITE_DEFAULT_LOCALE=ar
VITE_DEFAULT_THEME=dark

# Public origin used to build QR tracking links (Phase 09).
VITE_PUBLIC_TRACK_BASE=http://localhost:5173

# HTTP timeout in milliseconds.
VITE_REQUEST_TIMEOUT_MS=20000

# ----------------------------------------------------------
# Demo sign-in helper (development / demo deployments only)
# ----------------------------------------------------------
# Format: role:email pairs, comma separated. Leave empty to hide the panel.
VITE_DEMO_ACCOUNTS=super_admin:mahmoud.elsebaey@fixer.app,manager:karim.mansour@fixer.app,technician:youssef.ragab@fixer.app,receptionist:ahmed.sherif@fixer.app,inventory_manager:doaa.kamel@fixer.app

# Password shared by every seeded account. Must match SEED_PASSWORD on the server.
VITE_DEMO_PASSWORD=Fixer@2026
